[Unit]
Description=NSE live websocket ingest (EXAMPLE — use nse-ingest.service)
After=network.target
# Kept so older docs still resolve. Production unit is nse-ingest.service.
# Never enable a second ingest from a PC checkout.

[Service]
Type=simple
User=nse
WorkingDirectory=/home/nse/nse-signal-pipeline
Environment=PYTHONPATH=src
EnvironmentFile=-/home/nse/nse-signal-pipeline/.env
ExecStart=/home/nse/nse-signal-pipeline/.venv/bin/python scripts/01_run_ingestion.py
Restart=on-failure
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
