[Unit]
Description=NSE live websocket ingest (exactly one Kite market-data process)
After=network-online.target
Wants=network-online.target
# Started by nse-ingest.timer (Mon-Fri 08:45 machine TZ) and on boot (WantedBy).
# Clean SIGTERM exits 0; Restart=on-failure does not loop on a clean stop.
# The timer brings the unit back for the next weekday session.
# Do not start this unit while a manual nohup ingest is already running.

[Service]
Type=simple
User=nse
Group=nse
WorkingDirectory=/home/nse/nse-signal-pipeline
Environment=PYTHONPATH=src
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/nse/nse-signal-pipeline/.env
ExecStart=/home/nse/nse-signal-pipeline/.venv/bin/python scripts/01_run_ingestion.py
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
RestartSec=30
StartLimitBurst=5
StartLimitIntervalSec=600
SyslogIdentifier=nse-ingest

[Install]
WantedBy=multi-user.target
