[Unit]
Description=NSE weekly retrain (versioned files; never auto-promote)
After=network-online.target

[Service]
Type=oneshot
User=nse
Group=nse
WorkingDirectory=/home/nse/nse-signal-pipeline
Environment=PYTHONPATH=src
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/nse/nse-signal-pipeline/.env
ExecStart=/home/nse/nse-signal-pipeline/.venv/bin/python scripts/11_run_retrain.py --skip-harness
